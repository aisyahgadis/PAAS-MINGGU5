{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paas-ujicoba",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
